#!/bin/bash
#PBS -N strong_scaling
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=128:mem=128gb:cpu_type=rome

# PBS script for running the strong scaling study on CX3

module purge
module load tools/prod miniforge/3

# activate env via conda
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate irp

# navigate to working dir
cd $PBS_O_WORKDIR

# install latest package version
pip install .

OUT=results/performance/strong_scaling.jsonl
mkdir -p results/performance

F0=100e3
PPW=10
REPEATS=3
CORES="1 2 4 8 16 32 64 128"

# set thread affinity and location
export OMP_PROC_BIND=close
export OMP_PLACES=cores

# OMP is disabled by default so we need to export
export DEVITO_LANGUAGE=openmp

# sweep cores
for c in $CORES; do
    echo "=== ncores=$c ==="

    # ODIL: parallelism comes from the worker pool, so pin OpenMP to 1

    # first, the cached run
    OMP_NUM_THREADS=1 python3 experiments/exp2_performance_scaling.py --solver odil --mode cached --ncores "$c" --f0 $F0 --ppw $PPW --repeats $REPEATS --out "$OUT"

    # second the on-the-fly
    OMP_NUM_THREADS=1 python3 experiments/exp2_performance_scaling.py --solver odil --mode uncached --ncores "$c" --f0 $F0 --ppw $PPW --repeats $REPEATS --out "$OUT"

    # Devito: parallelism is OpenMP over the grid, so OMP is the knob
    export OMP_NUM_THREADS=$c 
    python3 experiments/exp2_performance_scaling.py --solver devito --mode na --ncores "$c" --f0 $F0 --ppw $PPW --repeats $REPEATS --out "$OUT"
done

echo "done -> $OUT"
