#!/bin/bash
#PBS -N cfl-sweep
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=1:mem=16gb:cpu_type=rome

# PBS script for the CFL sweep on CX3

module purge
module load tools/prod miniforge/3

eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate irp

cd $PBS_O_WORKDIR
pip install .[test]

WHICH=${WHICH:?set WHICH=homog or sl via qsub -v}

OUT=results/wave/cfl_sweep_${WHICH}.jsonl
mkdir -p results/wave

export OMP_PROC_BIND=close
export OMP_PLACES=cores
export OMP_NUM_THREADS=1

for cfl in 0.5 0.7 0.9 0.95 1.0 1.05 1.1 1.3; do
    echo "=== cfl_safety=$cfl ==="
    python3 experiments/exp4_cfl_sweep.py --cfl-safety "$cfl" --out "$OUT" --which "$WHICH"
done

echo "done -> $OUT"
