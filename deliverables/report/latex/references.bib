@article{doi:10.1137/0909057,
	title = {On the complexity of sparse \${QR}\$ and \${LU}\$ factorization of finite-element matrices},
	volume = {9},
	url = {https://doi.org/10.1137/0909057},
	doi = {10.1137/0909057},
	abstract = {Let A be an \$n ×n\$ sparse nonsingular matrix derived from a two-dimensional finite-element mesh. If the matrix is symmetric and positive definite, and a nested dissection ordering is used, then the Cholesky factorization of A can be computed using \$O(n{\textasciicircum}3 / 2 )\$ arithmetic operations, and the number of nonzeros in the Cholesky factor is \$O(nn)\$. In this article we show that the same complexity bounds can be attained when A is nonsymmetric and indefinite, and either Gaussian elimination with partial pivoting or orthogonal factorization is applied. Numerical experiments for a sequence of irregular mesh problems are provided.},
	number = {5},
	journal = {SIAM Journal on Scientific and Statistical Computing},
	author = {George, Alan and Ng, Esmond},
	year = {1988},
	note = {tex.eprint: https://doi.org/10.1137/0909057},
	pages = {849--861},
}

