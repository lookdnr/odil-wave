@article{chekrounTimedomainNumericalSimulations2012,
  title = {Time-Domain {{Numerical Simulations}} of {{Multiple Scattering}} to {{Extract Elastic Effective Wavenumbers}}},
  author = {Chekroun, Mathieu and Marrec, Lo{\"i}c Le and Lombard, Bruno and Piraux, Jo{\"e}l},
  year = 2012,
  month = aug,
  journal = {Waves in Random and Complex Media},
  volume = {22},
