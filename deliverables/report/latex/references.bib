
@incollection{kelley2LocalConvergence1999,
	series = {Frontiers in {Applied} {Mathematics}},
	title = {2. {Local} {Convergence} of {Newton}'s {Method}},
	isbn = {978-0-89871-433-3},
	url = {https://epubs-siam-org.iclibezp1.cc.ic.ac.uk/doi/10.1137/1.9781611970920.ch2},
	doi = {10.1137/1.9781611970920.ch2},
	abstract = {By a local convergence method we mean one that requires that the initial iterate x0 is close to a local minimizer x* at which the sufficient conditions hold.2.1 Types of ConvergenceWe begin with the standard taxonomy of convergence rates [84], [154], [211].Definition 2.1.1. Let \{xn\}⊂RN and x*∈RN. Then• xn→x* q-quadratically if xn→x* and there is K{\textgreater}0 such that‖xn+1−x*‖≤K‖xn−x*‖2.• xn→x* q-superlinearly with q-order α{\textgreater}1 if xn→x* and there is K{\textgreater}1 such that‖xn+1−x*‖≤K‖xn−x*‖α.• xn→x* q-superlinearly iflimn→∞‖xn+1−x*‖‖xn−x*‖=0.• xn→x* q-linearly with q-factor σ ∊ (0, 1) if‖xn+1−x*‖≤σ‖xn−x*‖for n sufficiently large.Definition 2.1.2. An iterative method for computing x* is said to be locally (q-quadratically, q-superlinearly, q-linearly, etc.) convergent if the iterates converge to x* (q-quadratically, q-superlinearly, q-linearly, etc.) given that the initial data for the iteration is sufficiently good.},
	urldate = {2026-08-22},
	booktitle = {Iterative {Methods} for {Optimization}},
	publisher = {Society for Industrial and Applied Mathematics},
	author = {Kelley, C. T.},
	month = jan,
	year = {1999},
	pages = {13--37},
}

